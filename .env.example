# Email delivery for the "Source My Car" form and campaign digests (Resend).
# Sign up at https://resend.com, verify the cksretrogarage.com domain,
# create an API key, and set it here (and in Render env vars).
RESEND_API_KEY=
RESEND_FROM="CK’s Retro Garage <leads@cksretrogarage.com>"

# ---- Sourcing campaigns (admin > Sourcing Campaigns) ----
# Web-search sourcing uses this (Claude web search tool). Usually already set.
ANTHROPIC_API_KEY=
# Optional: model for campaign web search (default claude-sonnet-4-6).
ANTHROPIC_CAMPAIGN_MODEL=
# Optional structured aggregator (US + Canada dealer/private/auction inventory).
# Get a key at https://www.marketcheck.com/apis (free tier available).
MARKETCHECK_API_KEY=
# Optional override of the Marketcheck API base URL.
MARKETCHECK_BASE=
# Optional eBay Motors source (structured live eBay listings).
# Create a free app at https://developer.ebay.com (Production keyset).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Shared secret guarding the twice-daily monitor at /api/cron/campaigns.
# The cron caller must send it as `Authorization: Bearer <value>` or `?secret=<value>`.
CRON_SECRET=
# Fallback recipient for campaign alert emails (per-campaign email overrides this).
CAMPAIGN_ALERT_EMAIL=
# Absolute site URL used in email links (e.g. https://cksretrogarage.onrender.com).
NEXT_PUBLIC_SITE_URL=
